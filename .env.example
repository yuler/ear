# Cloudflare deployment credentials (for www deployment via Wrangler)
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Recommended template: "Edit Cloudflare Workers"
# Required permissions:
#   - Account > Workers Scripts > Edit
#   - Zone > Workers Routes > Edit (if deploying to custom domains)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional local overrides for Ear CLI / App
# EAR_DISCOVER_URL=https://raw.githubusercontent.com/yuler/ear/main/api/discover
# EAR_LIBRARY_DIR=
