# Cloudflare deployment credentials (for web deployment via Wrangler)
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Recommended template: "Edit Cloudflare Workers"
# Required permissions:
#   - Account > Workers Scripts > Edit
#   - Zone > Workers Routes > Edit (if deploying to custom domains)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional local overrides for Ear CLI / App
# EAR_DISCOVER_URL=https://raw.githubusercontent.com/yuler/ear/main/api/discover
# EAR_LIBRARY_DIR=

# Required iOS TestFlight secrets (push with: ./scripts/setup-testflight.sh push-secrets --apply)
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_BASE64=
IOS_DEVELOPMENT_TEAM=
IOS_DISTRIBUTION_CERT_P12_BASE64=
IOS_DISTRIBUTION_CERT_PASSWORD=

# Optional GitHub Actions repository variables (do NOT store as secrets):
#   gh variable set ASC_APP_ID --body "6839099514"
#   gh variable set TESTFLIGHT_EXTERNAL_GROUP --body "External"
# ASC_APP_ID=6839099514
# TESTFLIGHT_EXTERNAL_GROUP=External
