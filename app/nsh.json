{
  "name": "Ear",
  "id": "com.cozilla.ear",
  "version": "1.0.0",
  "build": 1,
  "appearance": "dark",
  "theme": "theme.json",
  "capabilities": {
    "clipboard": true,
    "network": {
      "hosts": ["*"]
    },
    "fs": {
      "read": ["${dataDir}", "${homeDir}/Downloads"],
      "write": ["${dataDir}", "${homeDir}/Downloads"]
    }
  }
}
