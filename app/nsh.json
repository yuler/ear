{
  "name": "Ear",
  "id": "dev.yuler.ear",
  "version": "0.0.0",
  "build": 1,
  "singleInstance": true,
  "updater": {
    "github": "yuler/ear",
    "publicKey": "afYAB8DPnOq0sIl2NOMFatEFS+DoPs6C01B4aReXyy4=",
    "packages": {
      "roots": [
        "DyJPidhdmiTBxcizxAGmqxP4xJnNI/IIOV4au0Ni/u4="
      ]
    }
  },
  "appearance": "dark",
  "theme": "theme.json",
  "capabilities": {
    "clipboard": true,
    "network": {
      "hosts": [
        "*"
      ]
    },
    "fs": {
      "read": [
        "${dataDir}",
        "${homeDir}/Downloads"
      ],
      "write": [
        "${dataDir}",
        "${homeDir}/Downloads"
      ]
    },
    "process": {
      "env": [
        "EAR_DATA_DIR",
        "EAR_ENV",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS",
        "XDG_CURRENT_DESKTOP",
        "XDG_DATA_DIRS",
        "XDG_CONFIG_DIRS",
        "USER",
        "LOGNAME",
        "XAUTHORITY"
      ],
      "execute": [
        "ear",
        "ear.exe",
        "yt-dlp",
        "ffmpeg",
        "curl",
        "cp",
        "xdg-open",
        "open",
        "gio",
        "nautilus",
        "dolphin",
        "dbus-send",
        "gdbus"
      ]
    }
  }
}
