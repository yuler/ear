{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ear-www",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "ear.yuler.dev",
      "custom_domain": true
    }
  ]
}
